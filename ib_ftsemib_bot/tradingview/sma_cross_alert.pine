//@version=5
indicator("FTSE MIB SMA Cross Alert", overlay=true)

// Stessa logica del bot Python: incrocio rialzista SMA breve/lunga,
// con calcolo di un prezzo target informativo (+X%) e guadagno stimato
// su un capitale di riferimento. Nessun ordine viene inviato: solo alert.

smaShortLen = input.int(20, "SMA breve")
smaLongLen  = input.int(50, "SMA lunga")
targetPct   = input.float(3.0, "Target gain %")
capitalEur  = input.float(100.0, "Capitale di riferimento (EUR)")

smaShort = ta.sma(close, smaShortLen)
smaLong  = ta.sma(close, smaLongLen)

bullishCross = ta.crossover(smaShort, smaLong)

plot(smaShort, color=color.blue, title="SMA breve")
plot(smaLong, color=color.orange, title="SMA lunga")
plotshape(bullishCross, style=shape.triangleup, location=location.belowbar,
     color=color.green, size=size.small, title="Segnale acquisto")

targetPrice = close * (1 + targetPct / 100)
shares      = capitalEur / close
gainEur     = shares * (targetPrice - close)

if bullishCross
    msg = syminfo.ticker + " - SEGNALE ACQUISTO\n" +
         "Prezzo: " + str.tostring(close, format.mintick) + " EUR\n" +
         "SMA" + str.tostring(smaShortLen) + ": " + str.tostring(smaShort, format.mintick) +
         "  SMA" + str.tostring(smaLongLen) + ": " + str.tostring(smaLong, format.mintick) + "\n" +
         "Target (+" + str.tostring(targetPct, "#.#") + "%): " + str.tostring(targetPrice, format.mintick) + " EUR\n" +
         "Guadagno stimato su " + str.tostring(capitalEur, "#") + " EUR: " + str.tostring(gainEur, "#.##") + " EUR"
    alert(msg, alert.freq_once_per_bar_close)
